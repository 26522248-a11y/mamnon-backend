# Copy to deploy/.env (never commit it). Generate secrets with: openssl rand -base64 48
DOMAIN=mamnon.example.vn          # public domain pointing to this server (or "localhost" for a local test)
ACME_EMAIL=it@example.vn          # Let's Encrypt contact

# First admin, created once by the `migrate` service (skipped when an admin exists). >= 10 chars, letters + digits,
# not 123456/common. Must be changed at first login. Remove INITIAL_ADMIN_PASSWORD from this file after the first start.
INITIAL_ADMIN_USERNAME=hieutruong
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Cô Hiệu trưởng

POSTGRES_PASSWORD=change-me-long-random
JWT_ACCESS_SECRET=change-me-long-random-1
JWT_REFRESH_SECRET=change-me-long-random-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SCHOOL_NAME=Trường Mầm non Hoa Sen
# School identity: GET /settings/school (public), receipt / voucher / Excel headers
SCHOOL_ADDRESS=12 Đường Hoa Sen, Phường 1, TP. Hồ Chí Minh
SCHOOL_PHONE=028 3812 3456

LOGIN_MAX_FAILS=5
LOGIN_IP_MAX_FAILS=30
LOGIN_LOCK_MINUTES=15

# Backups (Asia/Ho_Chi_Minh time). BACKUP_DIR is a host path – ideally a separate disk, and copy it off-site.
BACKUP_TIME=02:30
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_ON_START=false

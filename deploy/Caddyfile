# HTTPS is automatic (Let's Encrypt) once DOMAIN points to this server and ports 80/443 are open.
# For a LAN / test run without a public domain set DOMAIN=localhost (Caddy uses its own local CA).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API (incl. Swagger at /api/docs). Photos are only served by the API with auth; there is no public /uploads.
	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}

PORT=3001
DATABASE_URL=postgres://mamnon:mamnon@localhost:5432/mamnon
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TZ_SCHOOL=Asia/Ho_Chi_Minh
SCHOOL_NAME=Mầm non Như Ý
# School identity: GET /settings/school (public), receipt / voucher / Excel headers
SCHOOL_ADDRESS=12 Đường Hoa Sen, Phường 1, TP. Hồ Chí Minh
SCHOOL_PHONE=028 3812 3456
LOGIN_MAX_FAILS=5
LOGIN_IP_MAX_FAILS=30
LOGIN_LOCK_MINUTES=15
# TRUST_PROXY=1
# UPLOAD_DIR=/var/lib/mamnon/uploads

# Excel import: auto-create unknown classes when the request does not say (true/false)
IMPORT_CREATE_CLASSES=false

# ── An toàn đón trẻ: notifications ──
# Channels: inapp (inbox), webpush (browser / installed PWA), sms + zalo (stubs, not wired yet: logged as 'skipped')
NOTIFY_CHANNELS=inapp,webpush
# Web push VAPID keys, generate once with: npx web-push generate-vapid-keys (keep the private key secret; changing them
# invalidates every browser subscription). Empty = web push disabled (in-app + 15-minute call prompt still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@example.vn
# Signs the short-lived token inside the push payload (Confirm / Reject buttons). Default: derived from JWT_ACCESS_SECRET.
PUSH_ACTION_SECRET=
# Public base URL of the API as seen by the parent's phone (push action / photo links), e.g. https://mamnon.example.vn
PUBLIC_API_BASE=
# Minutes without the parent's answer before the teacher is prompted to call the parent (phone 1, then 2)
PICKUP_ESCALATE_MINUTES=15
# Fallback channel stubs (add "sms" / "zalo" to NOTIFY_CHANNELS once a provider is wired)
SMS_PROVIDER=
SMS_API_KEY=
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
